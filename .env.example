# ZAK Studio Web - Environment Configuration
# Copy this to .env and fill in your credentials
# NEVER commit .env to version control!

# ===== REQUIRED (System won't start without these) =====
AGENTMAIL_API_KEY=your_agentmail_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here
UNSUB_SECRET=generate_with_openssl_rand_hex_32

# ===== PAYMENT / BANKING (REQUIRED for automation) =====
# IBAN where you receive payments (ONLY THIS IBAN)
USER_IBAN=IT60X0542811101000000123456
BANK_NAME=BPER Banca
ACCOUNT_HOLDER=Mario Rossi
COMPANY_LEGAL_NAME=Mario Rossi
COMPANY_ADDRESS=Via Roma 123, 25121 Brescia
COMPANY_VAT=01234567890
COMPANY_REA=BS-123456

# ===== PRICING =====
LANDING_PAGE_PRICE_EUR=2500
VAT_RATE=0.22
PAYMENT_TERMS_DAYS=15

# ===== EMAIL / ESP =====
# Resend (for sending emails)
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# ===== GOOGLE SHEETS =====
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"your-service@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_SHEETS_TRACKING_ID=1hD75vPwnT0SYpF-2rvZqbDfVu5kpe8onoZcM_Q06BRA

# ===== WEBHOOKS =====
AGENTMAIL_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
CRON_SECRET=zak-cron-secret-2026

# ===== FORMSPREE (for landing page contact forms) =====
FORMSPREE_FORM_ID=your_formspree_form_id

# ===== CALENDLY =====
CALENDLY_URL=https://calendly.com/zakstudio/discovery-call-15min

# ===== DEPLOYMENT =====
DEPLOY_PROVIDER=netlify
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_org_id
VERCEL_PROJECT_ID=your_project_id

# ===== APIFY (for lead discovery) =====
APIFY_TOKEN=your_apify_api_token

# ===== OPENAI (optional, for AI enhancements) =====
OPENAI_API_KEY=sk_your_openai_key

# ===== SLACK (for alerts) =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# ===== AUTO PAYMENT CHECKER (optional - for automatic payment detection) =====
# IMAP for parsing bank notification emails (Gmail, Outlook, etc.)
IMAP_ENABLED=false
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your_email@gmail.com
IMAP_APP_PASSWORD=your_gmail_app_password
IMAP_FOLDER=INBOX
IMAP_SENDER_FILTER=noreply@buddybank.it,alert@buddybank.it,notifiche@nexi.it
IMAP_DAYS_BACK=2

# Buddy Bank webhook (if available)
BUDDY_WEBHOOK_SECRET=your_buddy_webhook_secret

# Stripe (if using Stripe for payments)
STRIPE_API_KEY=sk_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ===== APP =====
APP_URL=https://zakstudio.com
NODE_ENV=production
PRIVACY_URL=https://zakstudio.com/privacy