# Ghost CMS Configuration
GHOST_API_URL=https://your-ghost-instance.railway.app
GHOST_CONTENT_API_KEY=your_content_api_key_here
GHOST_ADMIN_API_KEY=your_admin_api_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Your Company Name
NEXT_PUBLIC_DEFAULT_LOCALE=it
NEXT_PUBLIC_SUPPORTED_LOCALES=it,en

# Email Configuration (for RFQ forms)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@your-domain.com
RFQ_RECIPIENT_EMAIL=commercial@your-domain.com

# CRM Webhook (optional)
CRM_WEBHOOK_URL=https://your-crm.com/webhook/rfq
CRM_WEBHOOK_SECRET=your_webhook_secret

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Monitoring
CHECKLY_API_KEY=your_checkly_key
CHECKLY_ACCOUNT_ID=your_account_id

# Deployment
NETLIFY_AUTH_TOKEN=your_netlify_token
NETLIFY_SITE_ID=your_site_id
VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_project_id
VERCEL_ORG_ID=your_org_id

# reCAPTCHA (for forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key

# Feature Flags
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_MULTILANG=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true